{
    "name":  "api-studio-frontend",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "description":  "Studio untuk Platform API Management Low-Code (BRD v0.1)",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "check:yaml":  "esbuild scripts/yaml.check.ts --bundle --platform=node --format=esm --outfile=scripts/_yaml.check.mjs --log-level=error \u0026\u0026 node scripts/_yaml.check.mjs"
                },
    "dependencies":  {
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1"
                     },
    "devDependencies":  {
                            "@types/react":  "^18.3.11",
                            "@types/react-dom":  "^18.3.1",
                            "@vitejs/plugin-react":  "^4.3.2",
                            "autoprefixer":  "^10.4.20",
                            "postcss":  "^8.4.47",
                            "tailwindcss":  "^3.4.13",
                            "typescript":  "^5.6.3",
                            "vite":  "^5.4.9"
                        },
    "allowScripts":  {
                         "esbuild@0.21.5":  true
                     }
}